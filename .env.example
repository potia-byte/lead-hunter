# Only needed for live runs (npm run hunt -- --live). The demo needs none of these.
# Never commit real values.

# --- Telegram (optional teleproto adapter; READ-ONLY use) ---
# Obtain API credentials for YOUR OWN account at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# A pre-authorised StringSession for a user account. The module never logs in itself.
TELEGRAM_SESSION=

# --- Any OpenAI-compatible chat-completions endpoint (optional) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
